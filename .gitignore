# =============================================================================
# MBFD Hub — .gitignore
# Government-grade exclusion policy: deny-by-default for secrets, credentials,
# backups, build artifacts, IDE configs, and environment-specific files.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Environment & Secrets (CRITICAL — never commit)
# ---------------------------------------------------------------------------
.env*
!.env.example
!.env.testing.example
/auth.json
*.extras.env

# Playwright MCP captures (browser session dumps for debugging — local only)
/.playwright-mcp/

# Scratch directory for local Cloudflare API work — tunnel configs, cookies,
# pin-gate secrets, etc. NEVER commit.
/.cf-work/
cookies.txt
*pin-gate-secrets*
*.secrets-cheatsheet
*secrets-cheatsheet*

*.pem
*.key
*.p12
*.pfx
**/google_service_account.json
**/creds.json
**/credentials.json

# ---------------------------------------------------------------------------
# 2. Dependencies & Build Artifacts
# ---------------------------------------------------------------------------
/vendor
/node_modules
**/node_modules
# Lock files are source-controlled supply-chain inputs. Do not ignore them.
# Generated build output (Vite / Filament / Daily PWA). Reproduced by the
# deployment pipeline; never edited by hand and must not be Git-tracked.
/public/build/
/public/build-previous/
/public/daily-previous/
/public/deploy-marker.json
/public/css/filament/
/public/js/filament/
/public/daily/
/public/hot
/public/storage
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
npm-debug.log
yarn-error.log

# ---------------------------------------------------------------------------
# 3. IDE & Editor
# ---------------------------------------------------------------------------
/.fleet
/.idea
/.nova
/.vscode
/.zed
*.code-workspace

# Local agent state and linked worktrees are never part of the application.
/.agent/
/.kilo/
/.claude-flow/
/.worktrees/

# ---------------------------------------------------------------------------
# 4. Laravel Framework
# ---------------------------------------------------------------------------
/storage/*.key
/storage/pail
Homestead.json
Homestead.yaml

# ---------------------------------------------------------------------------
# 5. Logs
# ---------------------------------------------------------------------------
*.log

# ---------------------------------------------------------------------------
# 6. Temporary / Debug / Scratch Files
# ---------------------------------------------------------------------------
/fix_*.php
/debug_*.php
/check_*.php
/verify_*.php
/create_*.sh
/test_*.php
/sentry_test.php
/temp_*
/scratch_*
*.bak
*.backup
*.backup2
*.old
*.b64

# ---------------------------------------------------------------------------
# 7. Scripts with Credentials / Operations Scripts
# ---------------------------------------------------------------------------
*.ps1
*.sh
!.husky/*.sh
!/scripts/operations/*.sh
!/infra/backup/*.sh
!/infra/cloudflared-watchdog/*.sh

# ---------------------------------------------------------------------------
# 8. Documentation with Sensitive Content
# ---------------------------------------------------------------------------
TOKEN_GENERATION_GUIDE.md
PROJECT_SUMMARY.md
.project_summary.md
PERFORMANCE_FIX_REPORT_2026-02-12.md
AI_AGENT_ERRORS.md

# Numbered project docs (contain IPs, credentials, architecture details)
[0-9].*.md
[0-9][0-9].*.md
MBFD_HUB_*.md
CLAUDE.md
VPS_*.md

# Plans directory (may contain credentials in prompt files)
plans/*PROMPT*.md
plans/*_FIXES_*.md

# ---------------------------------------------------------------------------
# 9. Decommissioned / Legacy Directories
# ---------------------------------------------------------------------------
/.ai/
/.ai_scaffold/
/.kilocode/
/.claude/
/laravel-app/
/temp_deploy/
/temp_files/
.local/
pics/
/WorkGroup_Files/
**/.venv/
**/__pycache__/
**/.pytest_cache/
*.py[cod]

# External clones and one-off remediation evidence have their own lifecycle.
/analysis/
/gmktec_prep*/
/mbfd-tactical-scene-simulator/
/owui-*/
/memory/

# ---------------------------------------------------------------------------
# 9a. TS Orchestrator source is tracked; runtime artifacts and secrets are not
# ---------------------------------------------------------------------------
/ts-orchestrator/.env
/ts-orchestrator/.env.*
!/ts-orchestrator/.env.example
!/ts-orchestrator/api/package-lock.json
!/ts-orchestrator/web/package-lock.json
/ts-orchestrator/api/dist/
/ts-orchestrator/web/dist/
/ts-orchestrator/exam-investigation/

# ---------------------------------------------------------------------------
# 10. Infrastructure / Deployment (environment-specific)
# ---------------------------------------------------------------------------
cloudflared-config.yml
compose-vps*.yaml
snipeit-compose.yaml
observability-compose.yaml
docker-compose.local-sandbox.yml

# ---------------------------------------------------------------------------
# 11. Database Backups & Data
# ---------------------------------------------------------------------------
backups/
*.dump
*.sql.gz
/*.csv
/import_*.sql
/snipeit_import.sql
/generate_*.py
/inventory_extractor.py

# ---------------------------------------------------------------------------
# 12. AI / MCP Local Artifacts
# ---------------------------------------------------------------------------
/.ai/mcp/**
/.kilocode/mcp.local.json
/.kilocode/worktrees/
/lancedb/
/models/

# ---------------------------------------------------------------------------
# 13. OS Files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# Playwright failure traces are local diagnostics; committed acceptance images live in tests/e2e/screenshots.
/test-results/*/

# Generated reflection / local test artifact (not source)
app/Services/OperationalForms/FrocZipReader.php.json
/testing

