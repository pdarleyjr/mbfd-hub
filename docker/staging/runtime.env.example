APP_NAME="MBFD Hub Staging"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.mbfdhub.com
APP_KEY=
LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mbfd_hub_staging
DB_USERNAME=mbfd_hub_staging
DB_PASSWORD=

CACHE_STORE=redis
CACHE_PREFIX=mbfd_hub_staging
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
SESSION_DRIVER=database
SESSION_COOKIE=mbfd_hub_staging_session
SESSION_DOMAIN=staging.mbfdhub.com
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

MAIL_MAILER=array
RESEND_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
WEBPUSH_ALLOWED_ENDPOINT_HOSTS=
SENTRY_DSN=
SENTRY_LARAVEL_DSN=
SNIPEIT_API_URL=
SNIPEIT_API_TOKEN=
SCREENTINKER_SYNC_URL=
SCREENTINKER_SYNC_TOKEN=
GOOGLE_SHEETS_APPARATUS_SYNC_ENABLED=false
PORTAL_WRITEBACK_ENABLED=false

BID_READER_TOKEN=
BID_AUTH_ISSUER=https://staging.mbfdhub.com
BID_AUTH_CALLBACKS=https://staging.bid.mbfdhub.com/api/auth/callback
BID_CONSOLE_URL=https://staging.bid.mbfdhub.com
HUB_STAGING_BID_ADMIN_PASSWORD=
HUB_STAGING_BID_MEMBER_PASSWORD=
HUB_STAGING_BID_WORKGROUP_PASSWORD=

POSTGRES_DB=mbfd_hub_staging
POSTGRES_USER=mbfd_hub_staging
POSTGRES_PASSWORD=
HUB_STAGING_RELEASE_SHA=
HUB_STAGING_APP_ENV=/opt/mbfd/staging/hub-federation/runtime.env
CLOUDFLARED_STAGING_TUNNEL_TOKEN=
