# SECURITY NOTES
# - Keep all secrets (VAPID, Reverb, Pusher) out of version control
# - Use strong, random keys for REVERB_APP_KEY and REVERB_APP_SECRET
# - In production, always use https/wss protocols
# - Generate VAPID keys using: php artisan webpush:vapid
# - Never commit .env file - only commit .env.example with placeholders

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Protected runtime-only secret used for eligible Employee first-login provisioning.
MBFD_EMPLOYEE_BOOTSTRAP_PASSWORD=

PULSEPOINT_WORKER_URL=https://pulsepoint-proxy.pdarleyjr.workers.dev/incidents

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Daily Checkout preactivation is restricted to an independently restored,
# disposable PostgreSQL candidate snapshot. Never point this connection at the
# live production database. Both flags must remain false except during the
# read-only restore proof, where the database identity itself must have no DML.
DAILY_CHECKOUT_PREACTIVATION_DB_URL=
DAILY_CHECKOUT_PREACTIVATION_DB_HOST=
DAILY_CHECKOUT_PREACTIVATION_DB_PORT=5432
DAILY_CHECKOUT_PREACTIVATION_DB_DATABASE=
DAILY_CHECKOUT_PREACTIVATION_DB_USERNAME=
DAILY_CHECKOUT_PREACTIVATION_DB_PASSWORD=
DAILY_CHECKOUT_PREACTIVATION_DB_CHARSET=utf8
DAILY_CHECKOUT_PREACTIVATION_DB_SSLMODE=prefer
DAILY_CHECKOUT_PREACTIVATION_CANDIDATE=false
DAILY_CHECKOUT_PREACTIVATION_READ_ONLY=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240

# Laravel Reverb (WebSocket Server for Real-Time Chat)
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_INTERNAL_HOST=127.0.0.1
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Broadcasting Driver (use "reverb" to enable real-time features)
BROADCAST_DRIVER=log

# Cloudflare WebSocket Notes:
# - When deploying behind Cloudflare with HTTPS, use:
#   REVERB_SCHEME=https
#   REVERB_HOST=your-domain.com
#   REVERB_PORT=443
# - Use Full/Strict SSL mode (not Flexible) for stable wss:// connections
# - WebSockets must be served over wss:// when site is https://
# - Consider using Cloudflare Tunnel for local development with HTTPS
# - In production, run Reverb via process manager (e.g., Supervisor)

# Cache / Queue / Session
# Local dev keeps these as 'database' / 'file' for zero-setup onboarding.
# Production should override to 'redis' across the board (compose.prod.yaml
# now ships a Redis container).
CACHE_STORE=database
CACHE_PREFIX=mbfdhub

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Single-DB Redis split into logical DB indexes prevents cache flushes from
# wiping queued jobs or active user sessions.
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Production overrides (place in production .env, NOT here) ----------------
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# BROADCAST_DRIVER=reverb
# BROADCAST_CONNECTION=reverb
# REDIS_HOST=redis            # container DNS name from compose.prod.yaml
# REDIS_PASSWORD=<strong-secret>
# -----------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sentry Configuration (Error Tracking & Performance Monitoring)
# Backend (Laravel) Sentry DSN
SENTRY_LARAVEL_DSN=
# Frontend Sentry DSN (for browser errors)
VITE_SENTRY_DSN=
# Sentry release version (auto-set by CI/CD, can override for local testing)
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=
# Sentry Organization and Projects (for source map uploads)
SENTRY_ORG=mbfd
SENTRY_PROJECT_BACKEND=support-backend
SENTRY_PROJECT_FRONTEND=support-frontend
# Sentry Auth Token (for CI/CD source map uploads, keep in GitHub Secrets)
SENTRY_AUTH_TOKEN=

# Dedicated Bid service credentials. Keep the canonical federation token
# separate from the transitional legacy password-verifier token.
BID_FEDERATION_TOKEN=
BID_READER_TOKEN=
BID_AUTH_ISSUER=https://www.mbfdhub.com
BID_CONSOLE_URL=https://staging.bid.mbfdhub.com

# Dedicated one-way service credential for Media Control authorization-code exchange.
# Generate independently; never reuse a human password, session, or device token.
MEDIA_CONTROL_FEDERATION_TOKEN=
MEDIA_CONTROL_AUTH_ISSUER=https://www.mbfdhub.com

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Workers AI Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct
AI_ANALYSIS_ENABLED=false

# Private MBFD AI Gateway generation contract. The application reads the
# dedicated bearer credential from this protected file; never place its value
# in the environment file. The compose host-source variable is separate.
AI_DRIVER=local
AI_GATEWAY_URL=http://172.20.0.1:11440
AI_GATEWAY_CAPABILITY=mbfd-general
AI_GATEWAY_CREDENTIAL_FILE=/run/secrets/mbfd-hub-ai-gateway-token
AI_GATEWAY_TIMEOUT=120
HUB_AI_GATEWAY_CREDENTIAL_SOURCE_FILE=

# Cloudflare Worker Integration
CLOUDFLARE_WORKER_URL=https://mbfd-support-ai.pdarleyjr.workers.dev
CLOUDFLARE_WORKER_API_SECRET=

# Workgroup AI document egress remains disabled unless all three values are
# deliberately configured after an approved data-classification/consent review.
WORKGROUP_AI_ENABLED=false
WORKGROUP_AI_WORKER_URL=
WORKGROUP_AI_WORKER_SECRET=

# Web Push Notifications (VAPID Keys)
# Generate keys using: php artisan webpush:vapid
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PEM_FILE=
# Comma-separated, exact browser-push delivery hosts. Leave blank until the
# supported browser providers are approved; registration fails closed when empty.
# Do not enter URLs, IP addresses, wildcards, or unapproved third-party hosts.
WEBPUSH_ALLOWED_ENDPOINT_HOSTS=

# Snipe-IT Integration
SNIPEIT_API_URL=http://snipeit:80/api/v1/
SNIPEIT_API_TOKEN=
SNIPEIT_STATUS_OUT_FOR_REPAIR_ID=4
SNIPEIT_STATUS_MISSING_ID=5

# ---------------------------------------------------------------------------
# Operational Forms — F-ROC AI WhatsApp import capacity
# ---------------------------------------------------------------------------
# These are SAFE DEFAULTS documented for operators. The application clamps
# malformed or out-of-range values to the ceilings defined in
# App\Services\OperationalForms\FrocImportLimits, so a wrong value here can
# only make a limit smaller, never larger. No secrets are involved.
#
# Maximum uploaded ZIP/TXT (KiB). 51200 KiB = 50 MiB. Hard ceiling: 50 MiB.
FROC_IMPORT_UPLOAD_MAX_KB=51200
#
# Maximum combined extracted text (bytes). 1048576 = 1 MiB. Hard ceiling: 1 MiB.
FROC_IMPORT_MAX_EXTRACTED_BYTES=1048576
#
# Maximum total ZIP entries inspected. Hard ceiling: 500.
FROC_IMPORT_MAX_ZIP_ENTRIES=500
#
# Maximum text (.txt) entries processed. Hard ceiling: 10.
FROC_IMPORT_MAX_TEXT_ENTRIES=10
#
# Maximum text-entry compression ratio (uncompressed / compressed). Hard ceiling: 100:1.
FROC_IMPORT_MAX_COMPRESSION_RATIO=100
#
# Independent ceiling for the text actually sent to the AI service (bytes).
# Tune to the approved logical capability context. Hard ceiling: 1 MiB.
FROC_IMPORT_MAX_MODEL_INPUT_BYTES=262144
#
# Force deterministic (rules-based) extraction even when AI is available.
FROC_IMPORT_FORCE_FALLBACK=false

# ---------------------------------------------------------------------------
# Native MBFD video conferencing (LiveKit Cloud with self-hosted fallback)
# ---------------------------------------------------------------------------
# Safe default: the employee page shows an unavailable state and requests no
# camera/microphone permissions until infrastructure and credentials are ready.
VIDEO_CONFERENCING_ENABLED=false
VIDEO_CONFERENCING_LINEUP_TIME=
VIDEO_CONFERENCING_LINEUP_MAX_MINUTES=15
VIDEO_CONFERENCING_STATUS_POLL_SECONDS=5
VIDEO_CONFERENCING_READY_HEARTBEAT_SECONDS=20
VIDEO_CONFERENCING_READY_STALE_SECONDS=75
VIDEO_CONFERENCING_USAGE_INFORMATION_GB=30
VIDEO_CONFERENCING_USAGE_WARNING_GB=35
VIDEO_CONFERENCING_USAGE_CONSERVATION_GB=40
VIDEO_CONFERENCING_USAGE_AGGRESSIVE_GB=45
VIDEO_CONFERENCING_COMMAND_PIN_HASH=
VIDEO_CONFERENCING_LIVEKIT_PROFILE=self_hosted
LIVEKIT_CLOUD_URL=wss://cloud-project.example.invalid
LIVEKIT_CLOUD_API_URL=https://cloud-project.example.invalid
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
LIVEKIT_SELF_HOSTED_URL=wss://video.example.invalid
LIVEKIT_SELF_HOSTED_API_URL=https://video.example.invalid
LIVEKIT_SELF_HOSTED_API_KEY=
LIVEKIT_SELF_HOSTED_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600
LIVEKIT_EMPTY_TIMEOUT_SECONDS=300
LIVEKIT_MAX_PARTICIPANTS=12
