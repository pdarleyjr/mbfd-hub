{
  "workgroup": {
    "name": "Mid-Mount Ladder Truck Equipment Evaluation",
    "department": "Miami Beach Fire Department",
    "fire_chief": "Digna Abello",
    "committee": "Health & Safety Committee",
    "session": "Ladder Truck Procurement Evaluation"
  },
  "evaluation": {
    "rubric": "SAVER",
    "categories": [
      {
        "id": "capability",
        "name": "Capability",
        "description": "Functional performance and features - how well it does the job",
        "weight": 0.25,
        "criteria": [
          "Performance under load",
          "Feature completeness",
          "Operational effectiveness",
          "Technical specifications"
        ]
      },
      {
        "id": "usability",
        "name": "Usability",
        "description": "Ease of use, ergonomics, training requirements",
        "weight": 0.20,
        "criteria": [
          "Intuitive operation",
          "Ergonomic design",
          "Training time required",
          "User interface quality"
        ]
      },
      {
        "id": "affordability",
        "name": "Affordability",
        "description": "Cost-effectiveness, value for budget",
        "weight": 0.20,
        "criteria": [
          "Initial purchase cost",
          "Total cost of ownership",
          "Value proposition",
          "Budget alignment"
        ]
      },
      {
        "id": "maintainability",
        "name": "Maintainability",
        "description": "Servicing, parts availability, durability",
        "weight": 0.20,
        "criteria": [
          "Ease of maintenance",
          "Parts availability",
          "Service network",
          "Durability/reliability"
        ]
      },
      {
        "id": "deployability",
        "name": "Deployability",
        "description": "Readiness for operational deployment, reliability",
        "weight": 0.15,
        "criteria": [
          "Time to deploy",
          "Infrastructure requirements",
          "Operational readiness",
          "Reliability track record"
        ]
      }
    ],
    "rating_scale": {
      "min": 1,
      "max": 5,
      "labels": {
        "1": "Poor",
        "2": "Below Average",
        "3": "Average",
        "4": "Good",
        "5": "Excellent"
      }
    },
    "recommendations": [
      {
        "id": "advance",
        "label": "Advance as Finalist",
        "description": "Product meets or exceeds requirements and should advance to final selection"
      },
      {
        "id": "maybe",
        "label": "Needs Further Review",
        "description": "Product has potential but requires additional evaluation or clarification"
      },
      {
        "id": "no",
        "label": "Do Not Advance",
        "description": "Product does not meet requirements or has disqualifying issues"
      }
    ],
    "confidence_levels": [
      "Very Low",
      "Low",
      "Moderate",
      "High",
      "Very High"
    ]
  },
  "product_categories": [
    {
      "id": "battery_hydraulics",
      "name": "Battery-Powered Hydraulic Tools",
      "ranking_type": "brand",
      "products": [
        {
          "name": "Cutter",
          "manufacturers": ["Holmatro", "Genesis", "Hurst", "Weber"]
        },
        {
          "name": "Spreader",
          "manufacturers": ["Holmatro", "Genesis", "Hurst", "Weber"]
        },
        {
          "name": "Ram",
          "manufacturers": ["Holmatro", "Genesis", "Hurst", "Weber"]
        }
      ]
    },
    {
      "id": "thermal_imaging",
      "name": "Thermal Imaging Cameras",
      "ranking_type": "individual",
      "manufacturers": ["FLIR", "Bullard", "MSA", "Scott"]
    },
    {
      "id": "ladders",
      "name": "Ground Ladders",
      "ranking_type": "individual",
      "manufacturers": ["Alaco", "DuoSafety", "FireDept_Specialty"]
    },
    {
      "id": "lighting",
      "name": "Scene Lighting Systems",
      "ranking_type": "individual",
      "manufacturers": ["CommandLight", "FRC", "Pemfab"]
    },
    {
      "id": "winches",
      "name": "Vehicle Winches",
      "ranking_type": "individual",
      "manufacturers": ["Warn", "Ramsey", "Superwinch"]
    }
  ],
  "ai_worker": {
    "base_url": "https://workgroup-ai.mbfdhub.com",
    "endpoints": {
      "vectorize": "/vectorize",
      "analyze": "/analyze",
      "summary": "/summary",
      "executive_report": "/executive-report",
      "health": "/health"
    },
    "models": {
      "text_generation": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "embeddings": "@cf/baai/bge-large-en-v1.5"
    },
    "rate_limits": {
      "requests_per_minute": 30,
      "window_ms": 60000
    }
  },
  "output": {
    "formats": ["markdown", "json"],
    "directory": ".deer-flow/outputs",
    "naming_convention": "{type}_{timestamp}.{ext}"
  }
}