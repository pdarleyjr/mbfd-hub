[Unit]
Description=Consistent MBFD authentik backup before encrypted ecosystem capture
Requires=docker.service
After=docker.service mbfd-authentik.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mbfd/authentik.env
ExecStart=/opt/mbfd/authentik/backup.sh
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/mbfd/authentik/backups
