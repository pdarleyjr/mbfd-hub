[Unit]
Description=MBFD Cloudflare tunnel watchdog (conservative; restarts cloudflared only)
After=network-online.target cloudflared.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/mbfd-cloudflared-watchdog.py
StateDirectory=mbfd-cloudflared-watchdog
LogsDirectory=mbfd-cloudflared-watchdog
# Exit 0 = healthy or recovered; 1 = unhealthy below threshold / cooldown; 2 = alert-only (storm cap / failed recovery)
SuccessExitStatus=0 1 2
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryMax=128M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mbfd-cloudflared-watchdog
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
