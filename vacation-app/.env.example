# ──────────────────────────────────────────────────────────────────
# MBFD Vacation Selection — V1 environment template
# Copy to .env on each environment. Never commit a populated .env.
# ──────────────────────────────────────────────────────────────────

# Public host (used by web app for absolute URLs, CSP, cookie scope)
PUBLIC_HOST=vacation.mbfdhub.com

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=vacation
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=vacation
# Internal docker DSN (apps inside the compose network use this)
DATABASE_URL=postgres://vacation:change-me-strong@vac-postgres:5432/vacation
# Host-side DSN for migrations from your laptop (delete in prod)
DATABASE_URL_HOST=postgres://vacation:change-me-strong@127.0.0.1:5432/vacation

# ── Redis (BullMQ broker) ─────────────────────────────────────────
REDIS_URL=redis://vac-redis:6379

# ── Cloudflare R2 (raw import storage) ────────────────────────────
# Pull values from your Cloudflare dashboard; bucket "mbfd-hub-laravel"
# already exists in this account. The R2 endpoint is jurisdiction-
# specific (see the docs in DEPLOYMENT.md).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=mbfd-hub-laravel
R2_PREFIX=vacation/imports/

# ── Inter-service secret (CF Worker → api audit webhook) ──────────
# Long random string. Generate with: openssl rand -hex 32
PIN_AUDIT_WEBHOOK_SECRET=change-me-random-32-bytes

# ── App ports (host bindings only matter for the prod overlay) ────
API_PORT=3001
WEB_PORT=3000
NGINX_HOST_PORT=7090

# ── Limits ────────────────────────────────────────────────────────
# Hard cap on upload size in bytes (1 GiB)
MAX_UPLOAD_BYTES=1073741824
# Hard cap on rows we will process per file
MAX_TELESTAFF_ROWS=5000000

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
