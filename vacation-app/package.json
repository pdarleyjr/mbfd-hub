{
  "name": "mbfd-vacation",
  "version": "0.1.0",
  "private": true,
  "description": "MBFD Vacation Selection Web App — V1 (import + read-only board)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter ./apps/* --filter ./packages/* run build",
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/worker --filter ./apps/web run dev",
    "dev:api": "pnpm --filter ./apps/api dev",
    "dev:worker": "pnpm --filter ./apps/worker dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "db:generate": "pnpm --filter ./packages/db drizzle-kit generate",
    "db:migrate": "pnpm --filter ./packages/db run migrate",
    "db:seed": "pnpm --filter ./packages/db run seed",
    "test": "pnpm -r run test",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "stress-fixture": "tsx scripts/stress-fixture.ts",
    "seed-dev": "tsx scripts/seed-dev.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "^22.10.0",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "browserslist": "4.28.8",
      "esbuild": "0.28.1",
      "ioredis": "5.10.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "sharp": "0.35.3",
      "tmp": "0.2.7",
      "undici": "6.27.0",
      "ws": "8.21.1"
    }
  }
}
