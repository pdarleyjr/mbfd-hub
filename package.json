{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "test:ci-configuration": "node --test tests/Node/ci-configuration.test.mjs",
        "test:changed-php-files": "node --test tests/Node/changed-php-files.test.mjs",
        "test:daily-checkout-e2e": "playwright test --config=playwright.daily-checkout.config.ts",
        "typecheck:operational-forms": "tsc -p tsconfig.operational-forms.json",
        "test:operational-forms-node": "node --test tests/Node/operational-forms/*.test.mjs",
        "test:operational-forms-e2e": "playwright test --config=playwright.operational-forms.config.ts",
        "test:video-conferencing-bundle": "node scripts/ci/check-video-conferencing-bundle.mjs",
        "test:video-conferencing-node": "node --test tests/Node/video-conferencing-*.test.mjs",
        "test:video-conferencing-e2e": "playwright test --config=playwright.video-conferencing.config.ts",
        "test:personnel-requests-e2e": "playwright test --config=playwright.personnel-requests.config.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@sentry/browser": "10.57.0",
        "@sentry/integrations": "7.114.0",
        "@sentry/vite-plugin": "5.3.0",
        "@vitejs/plugin-react": "6.0.2",
        "autoprefixer": "^10.4.20",
        "axios": "^1.18.1",
        "concurrently": "^9.2.4",
        "laravel-vite-plugin": "3.1.0",
        "postcss": "^8.5.23",
        "tailwindcss": "^3.4.13",
        "vite": "8.0.16"
    },
    "dependencies": {
        "@fluentui/react-components": "9.74.4",
        "@tanstack/react-query": "^5.90.21",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "dexie": "^4.3.0",
        "framer-motion": "^12.34.5",
        "laravel-echo": "2.4.0",
        "livekit-client": "2.21.0",
        "lucide-react": "^0.500.0",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "5.1.91",
        "pusher-js": "8.6.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "typescript": "^5.9.3",
        "zustand": "^5.0.11"
    },
    "overrides": {
        "brace-expansion": "5.0.9",
        "ip-address": "10.4.0",
        "js-yaml": "4.3.1",
        "nanoid": "3.3.18",
        "shell-quote": "1.10.0"
    }
}
