[Unit]
Description=MBFD stateful Cloudflare origin and HLS monitor
After=network-online.target cloudflared.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/mbfd-origin-monitor.py
StateDirectory=mbfd-origin-monitor
LogsDirectory=mbfd-origin-monitor
SuccessExitStatus=0 1 2
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
