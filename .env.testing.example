# Copy to .env.testing (gitignored) and use only disposable local test values.
#
# Used by PHPUnit (phpunit.xml has a "Testing" environment-mode reference) and
# the Playwright e2e suite (tests/e2e/*).
#
# RULES:
#   - Never commit a populated .env.testing. The .gitignore entry blocks it.
#   - E2E_ADMIN_* MUST come from your secret manager, not paste.
#   - Tests should mostly use the SQLite :memory: DB below, not the real PG.

APP_ENV=testing
APP_KEY=base64:replace-with-a-real-key-from-php-artisan-key-generate
APP_DEBUG=true
APP_URL=http://localhost

# Fast, isolated DB for PHPUnit / Pest feature tests.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# Cache/session — keep out of Redis so tests can't interfere with prod boxes.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local

# Disable noisy services in tests.
LOG_CHANNEL=null
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
SENTRY_LARAVEL_DSN=
WORKGROUP_AI_ENABLED=false
WORKGROUP_AI_WORKER_URL=
WORKGROUP_AI_WORKER_SECRET=
WEBPUSH_ALLOWED_ENDPOINT_HOSTS=

# Playwright E2E credentials — set ONLY for a disposable local server.
E2E_BASE_URL=http://127.0.0.1:8098
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional: verify-employee-login.php helper script
VERIFY_EMP_PASSWORD=
